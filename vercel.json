{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && yarn install --ignore-engines",
  "buildCommand": "cd frontend && yarn build",
  "framework": "nextjs",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
